diff -ruN a/lib/core/main_widgets/admin_back_link.dart b/lib/core/main_widgets/admin_back_link.dart
--- a/lib/core/main_widgets/admin_back_link.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/core/main_widgets/admin_back_link.dart	2026-09-27 12:07:35.149000013 +0000
@@ -0,0 +1,59 @@
+// ******************* FILE INFO *******************
+// File Name: admin_back_link.dart
+// Purpose: Small "← Parent" breadcrumb shown at the top of admin sub-pages
+//          (BUG-26). Pops back when there is history, otherwise goes to the
+//          parent section's URL — so it also works after a page reload.
+
+import 'package:flutter/material.dart';
+import 'package:flutter_screenutil/flutter_screenutil.dart';
+import 'package:go_router/go_router.dart';
+
+import '../constant/color.dart';
+import '../theme/new_theme.dart';
+
+class AdminBackLink extends StatelessWidget {
+  const AdminBackLink({
+    super.key,
+    required this.parentLabel,
+    required this.parentRoute,
+  });
+
+  /// e.g. 'Job Listing'
+  final String parentLabel;
+
+  /// e.g. '/jobs'
+  final String parentRoute;
+
+  @override
+  Widget build(BuildContext context) {
+    return Padding(
+      padding: EdgeInsets.only(bottom: 8.h),
+      child: MouseRegion(
+        cursor: SystemMouseCursors.click,
+        child: GestureDetector(
+          onTap: () {
+            final router = GoRouter.of(context);
+            if (router.canPop()) {
+              router.pop();
+            } else {
+              router.go(parentRoute);
+            }
+          },
+          child: Row(
+            mainAxisSize: MainAxisSize.min,
+            children: [
+              Icon(Icons.arrow_back_ios_new_rounded,
+                  size: 14.sp, color: ColorPick.primary),
+              SizedBox(width: 6.w),
+              Text(
+                parentLabel,
+                style: StyleText.fontSize14Weight500
+                    .copyWith(color: ColorPick.primary),
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
